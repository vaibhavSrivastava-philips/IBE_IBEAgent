{
  "Catalog": {

    "Codecs": {
      "hl7v2": { "Type": "hl7v2" },        
      "base64": { "Type": "base64" }       
    },

    "Pipelines": {
      "main": [ "passthrough" ],
      "blob": [ "blob-envelope-extract" ],   
      "file-http": [ "blob-envelope-extract", "media-type" ]   
    },

    "Formats": {
      "hl7-standard": { "Codec": "hl7v2" },
      "raw-bytes": { "Codec": "base64" }
    },

    "Workflows": {
      "adt": {
        "Pipeline": "main",
        "Format": "hl7-standard",
        "Settings": {
          "AckTimeoutSeconds": { "Description": "Seconds to wait for downstream delivery before NACK.", "Default": "30", "Min": 5, "Max": 60, "Bind": "Acknowledgement.TimeoutMs", "Scale": 1000 },
          "ReplyOnFilter": { "Description": "Reply with an HL7 AR reject when a message is filtered (true) or drop it silently (false).", "Default": "false", "Allowed": [ "true", "false" ], "Bind": "ReplyOnFilter" }
        }
      },
      "adt-multi": { "Pipeline": "main", "Formats": [ "hl7-standard", "raw-bytes" ] }, 
      "file-blob": { "Pipeline": "blob", "Format": "hl7-standard" }, 
      "file-http-relay": { "Pipeline": "file-http", "Format": "hl7-standard" } 
    },

    "MediaTypes": {
      ".pdf": "application/pdf",
      ".png": "image/png",
      ".jpg": "image/jpeg",
      ".jpeg": "image/jpeg",
      ".json": "application/json",
      ".xml": "application/xml",
      ".txt": "text/plain",
      ".hl7": "application/hl7-v2+er7"
    },

    "Resources": {
      "adt-default-rules": { "ContentType": "application/vnd.ibe.filter-rules+json", "Ref": "adt-default.rules.json" }
    }
  }
}
