{
  // Developer-owned building blocks. FSE contracts reference these BY NAME only; FSEs never
  // assemble stages or pick raw codecs. Four layers, each referencing the previous by name:
  //   Codecs    - registered encoders (plug-in Type + params)
  //   Pipelines - ordered processing stages; shared per contract, run once before fan-out
  //   Formats   - per-output-leg encoding bundle: a message Codec (+ optional BatchCodec)
  //   Templates - a contract blueprint an FSE picks: a shared Pipeline + a default per-leg Format
  //
  // This is the "plug-and-play code" side. Message-level/operational settings (Acknowledgement,
  // Retry, DeliveryGuarantee, Channel, batch enable/thresholds) are NOT here - they stay FSE-owned
  // in contractData.json.
  "Catalog": {

    "Codecs": {
      "hl7v2": { "Type": "hl7v2" }          // pass-through HL7 v2 message codec
    },

    // Named stage lists. Every stage token must be registered in the ComponentRegistry (via a
    // module-owned AddXxxStages() extension called from ComponentRegistryBuilder). Empty pipelines
    // are rejected by validation. "passthrough" is a TEMPORARY no-op stage (Core) that passes the
    // message through unchanged, until real stages (validate/filter/enrich) exist.
    "Pipelines": {
      "main": [ "hl7-classify", "passthrough" ]
    },

    // Per-leg encoding bundles. Codec names a Codecs entry (one message -> bytes).
    // BatchCodec (optional) names the Codecs entry used when an FSE enables batching on a leg.
    "Formats": {
      "hl7-standard": { "Codec": "hl7v2" }
    },

    // Contract blueprints. Pipeline is optional (omit = no processing stages). Format supplies the
    // default per-leg encoding; individual outputs may override it with their own Format. ReplyOnFilter
    // (dev default) decides what happens to a message the pipeline FILTERS: true = reply with an
    // intentional HL7 AR reject (carrying the reason); false/omitted = silently drop it. An FSE may
    // override it on the contract.
    "Templates": {
      "adt": { "Pipeline": "main", "Format": "hl7-standard", "ReplyOnFilter": false }
    }
  }
}
