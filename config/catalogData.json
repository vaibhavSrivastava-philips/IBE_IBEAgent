{
  // Developer-owned building blocks. FSE contracts reference these BY NAME only; FSEs never
  // assemble stages or pick raw codecs. Four layers, each referencing the previous by name:
  //   Codecs    - registered encoders (plug-in Type + params)
  //   Pipelines - ordered processing stages; shared per contract, run once before fan-out
  //   Formats   - per-output-leg encoding bundle: a message Codec (+ optional BatchCodec)
    //   Workflows  - a contract blueprint an FSE picks: a shared Pipeline + a default per-leg Format
  //
  // This is the "plug-and-play code" side. Message-level/operational settings (Acknowledgement,
  // Retry, DeliveryGuarantee, Channel, batch enable/thresholds) are NOT here - they stay FSE-owned
  // in contractData.json.
  "Catalog": {

    "Codecs": {
      "hl7v2": { "Type": "hl7v2" },        // pass-through HL7 v2 message codec
      "base64": { "Type": "base64" }       // decodes a base64 UTF-8 payload to raw bytes
    },

    // Named stage lists. Every stage token must be registered in the ComponentRegistry (via a
    // module-owned AddXxxStages() extension called from ComponentRegistryBuilder). Empty pipelines
    // are rejected by validation. "passthrough" is a TEMPORARY no-op stage (Core) that passes the
    // message through unchanged, until real stages (validate/filter/enrich) exist.
    "Pipelines": {
      "main": [ "passthrough" ],
      "blob": [ "blob-envelope-extract" ],   // reconstructs a {filename, filecontent(base64)} envelope into the original bytes; non-envelope payloads pass through unchanged
      "file-http": [ "blob-envelope-extract", "media-type" ]   // reconstruct any base64 file-envelope, then classify the wire Content-Type from the source file extension (via MediaTypes)
    },

    // Per-leg encoding bundles. Codec names a Codecs entry (one message -> bytes).
    // BatchCodec (optional) names the Codecs entry used when an FSE enables batching on a leg.
    "Formats": {
      "hl7-standard": { "Codec": "hl7v2" },
      "raw-bytes": { "Codec": "base64" }
    },

    // Contract blueprints. Pipeline is optional (omit = no processing stages). Format supplies the
    // default per-leg encoding; individual outputs may override it with their own Format. A Workflow
    // may instead declare an ordered "Formats" set: element [0] is the default every leg inherits, and
    // when the set has more than one, each output picks one by name (Output.Format, which must be a
    // member) - an output that omits it falls back to Formats[0] (logged). "Settings" is the flat
    // FSE-facing form the dev exposes: friendly name -> guardrails (Min/Max/Allowed/Regex) + a hidden
    // Bind target (a contract field, or Outputs[].X for every leg) + optional Scale. A Setting with no
    // Default is required. Anything NOT declared as a Setting is constant and invisible to the FSE.
    "Workflows": {
      "adt": {
        "Pipeline": "main",
        "Format": "hl7-standard",
        "Settings": {
          "AckTimeoutSeconds": { "Description": "Seconds to wait for downstream delivery before NACK.", "Default": "30", "Min": 5, "Max": 60, "Bind": "Acknowledgement.TimeoutMs", "Scale": 1000 },
          "ReplyOnFilter": { "Description": "Reply with an HL7 AR reject when a message is filtered (true) or drop it silently (false).", "Default": "false", "Allowed": [ "true", "false" ], "Bind": "ReplyOnFilter" }
        }
      },
      "adt-multi": { "Pipeline": "main", "Formats": [ "hl7-standard", "raw-bytes" ] },   // multi-format: an output picks "hl7-standard" or "raw-bytes"; omit -> the first (hl7-standard)
      "file-blob": { "Pipeline": "blob", "Format": "hl7-standard" },   // File relay that reconstructs base64 file-envelopes; the output file name comes from the envelope's filename (via the blob.name header)
      "file-http-relay": { "Pipeline": "file-http", "Format": "hl7-standard" }   // File -> HTTP relay: raw bytes pass through (hl7v2 codec is identity) and the Content-Type is derived from the file extension (legacy HttpSender parity)
    },

    // Extension -> media type map consumed by the "media-type" classifier stage. Developer-owned data:
    // add/override mappings without touching code (an unmapped extension keeps the output's ContentType).
    "MediaTypes": {
      ".pdf": "application/pdf",
      ".png": "image/png",
      ".jpg": "image/jpeg",
      ".jpeg": "image/jpeg",
      ".json": "application/json",
      ".xml": "application/xml",
      ".txt": "text/plain",
      ".hl7": "application/hl7-v2+er7"
    },

    // Named developer-shipped resource files a Kind:file Setting can point at (resolved to a path confined
    // to the resources root). Example of a workflow Setting consuming one:
    //   "FilterRules": { "Kind": "file", "ContentType": "application/vnd.ibe.filter-rules+json",
    //                    "Default": "adt-default-rules", "Bind": "stage:hl7-filter.Ruleset" }
    "Resources": {
      "adt-default-rules": { "ContentType": "application/vnd.ibe.filter-rules+json", "Ref": "adt-default.rules.json" }
    }
  }
}
