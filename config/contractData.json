{
  "Endpoints": {
    "TcpInbound": [
      {
        "SourceEndpointId": 6,
        "Port": 5101,
        "Format": "hl7v2"
      }
    ],
    "HttpOutbound": [
      {
        "OutputId": 105,
        "Endpoint": "http://localhost:9105/ibe/inbound",
        "ContentType": "application/json",
        "TimeoutSeconds": 30
      },
      {
        "OutputId": 106,
        "Endpoint": "http://localhost:5202/ibe/inbound",
        "ContentType": "application/octet-stream",
        "TimeoutSeconds": 5
      }
    ],
    "FileInbound": [
      {
        "SourceEndpointId": 4,
        "Directory": "C:\\ibe-test\\in",
        "FilePattern": "*.hl7;*.txt;*.dat;*.json",
        "PollIntervalSeconds": 2,
        "Format": "hl7v2",
        "KeepOriginalFiles": false,
        "RetentionDays": 0
      },
      {
        "SourceEndpointId": 5,
        "Directory": "C:\\ibe-test\\http-in",
        "FilePattern": "*.pdf;*.png;*.jpg;*.jpeg;*.json;*.xml;*.txt;*.hl7;*.dat",
        "PollIntervalSeconds": 2,
        "Format": "hl7v2",
        "KeepOriginalFiles": false,
        "RetentionDays": 0
      }
    ],
    "FileOutbound": [
      {
        "OutputId": 104,
        "Directory": "C:\\ibe-test\\out",
        "FileNameTemplate": "out_{timestamp}.{ext}",
        "DefaultExtension": "hl7",
        "AllowMessageDirectedPath": true   // honor an envelope's destinationpath (blob.path) as the output dir; false = always write to Directory
      }
    ]
  },
  "Contracts": [
    {
      "Name": "Demo-File-To-File",
      "Workflow": { "Use": "file-blob" },
      "Inputs": [ { "InputId": 4 } ],
      "Acknowledgement": { "IsEnabled": false },
      "Response": { "IsEnabled": false },
      "Outputs": [
        { "OutputId": 104 }
      ]
    },
    {
      "Name": "Legacy-File-To-Http",
      "Workflow": { "Use": "file-http-relay" },
      "Inputs": [ { "InputId": 5 } ],
      "Acknowledgement": { "IsEnabled": false },
      "Response": { "IsEnabled": false },
      "Outputs": [
        {
          "OutputId": 105,
          "DeliveryGuarantee": "AtMostOnce",
          "Retry": { "MaxAttempts": 4, "BackoffSeconds": 2, "Backoff": "Exponential" }
        }
      ]
    },
    {
      "Name": "Demo-Tcp-To-Http-Retry",
      "Workflow": { "Use": "adt" },
      "Inputs": [ { "InputId": 6 } ],
      "Acknowledgement": { "IsEnabled": true, "IsEnhanced": true, "Shape": "Single" },
      "Outputs": [
        {
          "OutputId": 106,
          "DeliveryGuarantee": "AtLeastOnce",
          "Retry": { "MaxAttempts": 1, "BackoffSeconds": 2, "Backoff": "Fixed" }
        }
      ]
    }
  ]
}

