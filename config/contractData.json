    // Manual File-in -> File-out test. Drop a file in C:\ibe-test\in -> agent reads it, runs the
    // "blob" pipeline (reconstructs a base64 {filename, filecontent} envelope into the original bytes;
    // plain files pass through), and writes it to C:\ibe-test\out.
    "FileInbound": [
      {
        "SourceEndpointId": 4,
        "Directory": "C:\\ibe-test\\in",
        "FilePattern": "*.hl7;*.txt;*.dat;*.json",
        "PollIntervalSeconds": 2,
        "Format": "hl7v2",
        "KeepOriginalFiles": false,
        "RetentionDays": 0
      },
      {
        "SourceEndpointId": 5,
        "Directory": "C:\\ibe-test\\http-in",
        "FilePattern": "*.pdf;*.png;*.jpg;*.jpeg;*.json;*.xml;*.txt;*.hl7;*.dat",
        "PollIntervalSeconds": 2,
        "Format": "hl7v2",
        "KeepOriginalFiles": false,
        "RetentionDays": 0
      }
    ],
    "FileOutbound": [
      {
        "OutputId": 104,
        "Directory": "C:\\ibe-test\\out",
        "FileNameTemplate": "out_{timestamp}.{ext}",
        "DefaultExtension": "hl7",
        "AllowMessageDirectedPath": true   // honor an envelope's destinationpath (blob.path) as the output dir; false = always write to Directory
      }
    ]
  },
