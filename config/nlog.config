<?xml version="1.0" encoding="utf-8"?>
<!--
  NLog configuration shared by both service hosts (Philips.IBE.Agent and Philips.IBE.Forward).
  Copied next to each exe by the host .csproj and auto-loaded by AddNLog().
  ${processname} differentiates the two services into their own log files from this one config.
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/logs/nlog-internal.log">

  <targets>
    <!-- Durable rolling file (the primary sink for a Windows service). Each service writes its own
         file via ${processname}; ${shortdate} rolls daily and maxArchiveDays keeps ~14 days. -->
    <target xsi:type="File" name="file"
            fileName="${basedir}/logs/${processname}-${shortdate}.log"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message}${onexception:inner=${newline}${exception:format=ToString}}"
            maxArchiveDays="14"
            keepFileOpen="false" />

    <!-- Console for interactive/dev runs. -->
    <target xsi:type="Console" name="console"
            layout="${time}|${level:uppercase=true}|${logger:shortName=true}|${message}${onexception:inner= ${exception:format=Message}}" />
  </targets>

  <rules>
    <!-- Trim framework noise: only Warn+ from Microsoft/System hosting infrastructure. -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />

    <!-- Levels are driven by appsettings.json (Logging:LogLevel): the Microsoft.Extensions.Logging
         category filter is the single gate, so NLog stays permissive (Trace) and writes whatever
         passes. The engine's IsEnabled(Trace) guards then skip the full-message decode unless Trace
         is enabled. Tiers: Trace = full message + full ack bodies; Debug = per-message + ids (future
         stage); Information = per-message flow (received/delivered/filtered/ack); Warning = problems only. -->
    <logger name="*" minlevel="Trace" writeTo="file,console" />
  </rules>
</nlog>
