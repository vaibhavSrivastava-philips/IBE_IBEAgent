{
  // Optional developer override. This file is copied next to the service executable and is loaded
  // after appsettings.json when DOTNET_ENVIRONMENT/ASPNETCORE_ENVIRONMENT is Development.
  // Trace may include full message bodies/ACKs (PHI) and should not be used in production.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Philips.IBE": "Trace",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System": "Warning"
    }
  }
}
