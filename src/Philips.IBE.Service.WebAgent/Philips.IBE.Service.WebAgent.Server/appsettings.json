{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtOptions": {
    "Issuer": "your-app",
    "Audience": "your-audience",
    "ExpirationSeconds": 1800
  },
  "Kestrel": {
    "AllowedHosts": "*",
    "EndPoints": {
      "Http": {
        "Url": "http://0.0.0.0:5513"
      },
      "HttpsInlineCertStore": {
        "Url": "https://0.0.0.0:7256",
        "Certificate": {
          "Subject": "",
          "Store": "",
          "Location": "",
          "AllowInvalid": ""
        }
      }
    }
  },
  "AuthenticationConfiguration": {
    "AuthenticationMode": "AD",
    "AdminUserGroup": "AdminGroup",
    "NormalUserGroup": "NormalGroup"
  },
  "CommonConfiguration": {
    "FolderPath": "C:\\IBEAgent_Config",
    "DatabaseEnabled": true,
    "CertificateFolderName": "Certificates",
    "DatabaseFileName": "transactionDB",
    "ServiceConfigPath": "",
    "License": ""
  },
  "NLog": {
    "throwConfigExceptions": true,
    "targets": {
      "async": true,
      "logfile": {
        "type": "File",
        "fileName": "c:/temp/nlog-${shortdate}.log"
      },
      "logconsole": {
        "type": "ColoredConsole"
      }
    },
    "rules": [
      {
        "logger": "*",
        "minLevel": "Info",
        "writeTo": "logconsole"
      },
      {
        "logger": "*",
        "minLevel": "Debug",
        "writeTo": "logfile"
      }
    ]
  },
  "AllowedHosts": "*"
}
