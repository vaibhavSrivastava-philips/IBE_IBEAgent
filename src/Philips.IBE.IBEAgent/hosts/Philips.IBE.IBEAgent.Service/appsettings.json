{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  // Sample topology: one Tcp inbound (no ack) + one Http inbound (ack) for HL7v2, both fanning
  // out to the same Tcp + Http outbound endpoints. Because Acknowledgement/Response is a
  // per-CONTRACT setting (not per-input), mixing "no ack" and "ack" for two sources that share
  // outputs is modeled as two contracts, each single-input, pointing at the same OutputIds.
  "Ibe": {
    "Endpoints": {
      "TcpInbound": [
        { "SourceEndpointId": 1, "Port": 6661, "Format": "hl7v2" }
      ],
      "HttpInbound": [
        { "SourceEndpointId": 2, "Prefix": "http://localhost:8080/ibe/", "Format": "hl7v2" }
      ],
      "TcpOutbound": [
        { "OutputId": 100, "Host": "downstream-tcp.example.local", "Port": 7001 }
      ],
      "HttpOutbound": [
        { "OutputId": 200, "Endpoint": "http://downstream-http.example.local/ibe/inbound" }
      ]
    },

    "Catalog": {
      "Pipelines": {
        "main": []
      },
      "Codecs": {
        "hl7v2": { "Type": "hl7v2" }
      }
    },

    "Contracts": {
      "Contracts": [
        {
          "Name": "Adt-Tcp-NoAck",
          "Inputs": [ { "InputId": 1 } ],
          "Pipeline": "main",
          "Acknowledgement": { "IsEnabled": false },
          "Outputs": [
            { "OutputId": 100, "Encoding": "hl7v2" },
            { "OutputId": 200, "Encoding": "hl7v2" }
          ]
        },
        {
          "Name": "Adt-Http-Ack",
          "Inputs": [ { "InputId": 2 } ],
          "Pipeline": "main",
          "Acknowledgement": { "IsEnabled": true, "IsEnhanced": true, "Shape": "Single" },
          "Outputs": [
            { "OutputId": 100, "Encoding": "hl7v2" },
            { "OutputId": 200, "Encoding": "hl7v2" }
          ]
        }
      ]
    }
  }
}
