<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!-- MAIN agent host (Windows service Philips.IBE.Agent).
       Publishes as Philips.IBE.IBEAgent.Service.exe -> publish/IBEAgent. Composition root. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="NLog.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Philips.IBE.IBEAgent.Core\Philips.IBE.IBEAgent.Core.csproj" />
    <ProjectReference Include="..\..\Philips.IBE.IBEAgent.Configuration\Philips.IBE.IBEAgent.Configuration.csproj" />
    <ProjectReference Include="..\..\Philips.IBE.IBEAgent.Persistence\Philips.IBE.IBEAgent.Persistence.csproj" />
    <ProjectReference Include="..\..\Philips.IBE.IBEAgent.Telemetry\Philips.IBE.IBEAgent.Telemetry.csproj" />
    <ProjectReference Include="..\..\Philips.IBE.IBEAgent.Security\Philips.IBE.IBEAgent.Security.csproj" />
    <ProjectReference Include="..\..\formats\Philips.IBE.IBEAgent.Formats.Hl7\Philips.IBE.IBEAgent.Formats.Hl7.csproj" />
    <ProjectReference Include="..\..\endpoints\Philips.IBE.IBEAgent.Endpoints.Tcp\Philips.IBE.IBEAgent.Endpoints.Tcp.csproj" />
    <ProjectReference Include="..\..\endpoints\Philips.IBE.IBEAgent.Endpoints.Http\Philips.IBE.IBEAgent.Endpoints.Http.csproj" />
    <ProjectReference Include="..\..\endpoints\Philips.IBE.IBEAgent.Endpoints.WebSocket\Philips.IBE.IBEAgent.Endpoints.WebSocket.csproj" />
    <ProjectReference Include="..\..\endpoints\Philips.IBE.IBEAgent.Endpoints.File\Philips.IBE.IBEAgent.Endpoints.File.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared runtime config lives in /config (repo root, doc §10). Copy it next to the exe so it is
         found in dev (bin) and after publish; the installer ships /config alongside the service. -->
    <Content Include="..\..\..\..\config\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\..\config\appsettings.Development.json" Link="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\..\config\catalogData.json" Link="catalogData.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\..\config\contractData.json" Link="contractData.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\..\config\nlog.config" Link="nlog.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="config\" />
  </ItemGroup>

</Project>
