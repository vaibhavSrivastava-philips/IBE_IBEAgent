    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Philips.IBE.IBEAgent.Core\Philips.IBE.IBEAgent.Core.csproj" />
    <ProjectReference Include="..\..\Philips.IBE.IBEAgent.Configuration\Philips.IBE.IBEAgent.Configuration.csproj" />
    <ProjectReference Include="..\..\Philips.IBE.IBEAgent.Persistence\Philips.IBE.IBEAgent.Persistence.csproj" />
    <ProjectReference Include="..\..\Philips.IBE.IBEAgent.Telemetry\Philips.IBE.IBEAgent.Telemetry.csproj" />
    <ProjectReference Include="..\..\Philips.IBE.IBEAgent.Security\Philips.IBE.IBEAgent.Security.csproj" />
    <ProjectReference Include="..\..\formats\Philips.IBE.IBEAgent.Formats.Hl7\Philips.IBE.IBEAgent.Formats.Hl7.csproj" />
    <ProjectReference Include="..\..\endpoints\Philips.IBE.IBEAgent.Endpoints.Tcp\Philips.IBE.IBEAgent.Endpoints.Tcp.csproj" />
    <ProjectReference Include="..\..\endpoints\Philips.IBE.IBEAgent.Endpoints.Http\Philips.IBE.IBEAgent.Endpoints.Http.csproj" />
    <ProjectReference Include="..\..\endpoints\Philips.IBE.IBEAgent.Endpoints.File\Philips.IBE.IBEAgent.Endpoints.File.csproj" />
    <ProjectReference Include="..\..\endpoints\Philips.IBE.IBEAgent.Endpoints.CimS3\Philips.IBE.IBEAgent.Endpoints.CimS3.csproj" />
  </ItemGroup>

</Project>
