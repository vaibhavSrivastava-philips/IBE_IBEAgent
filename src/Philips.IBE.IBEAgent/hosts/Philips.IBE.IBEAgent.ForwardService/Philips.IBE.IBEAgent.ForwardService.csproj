<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!-- Store-and-forward host (Windows service Philips.IBE.Forward).
       Publishes as Philips.IBE.IBEAgent.ForwardService.exe -> publish/ForwardService.
       Hosts the ForwardWorker out-of-process; re-delivers via the SAME endpoints/codecs. -->
