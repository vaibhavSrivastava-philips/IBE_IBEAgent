{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Forward": {
    "Store": "File",
    "StoreDirectory": "data/forward-store",
    "LeaseSeconds": 300,
    "PollIntervalSeconds": 5,
    "MaxAttempts": 5,
    "InitialBackoffSeconds": 5,
    "Backoff": "Exponential",
    "FetchBatchSize": 50
  }
}
